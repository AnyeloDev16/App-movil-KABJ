<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <!-- Área de Drop Zone -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardDropZone"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        app:cardCornerRadius="12dp"
        android:foreground="?android:attr/selectableItemBackground"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/dashed_border"
            android:padding="24dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/description_image_file_upload"
                android:src="@drawable/ic_file_upload"
                android:layout_marginBottom="16dp"
                android:alpha="0.8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/drag_and_drop_or"
                    android:layout_marginEnd="4dp"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/btnChooseFile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_file"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_clickable"
                    android:background="?android:attr/selectableItemBackground" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/formats"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:textStyle="italic"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Título de archivos subidos -->
    <TextView
        android:id="@+id/tvFilesTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sub_title_uploaded_files"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/cardDropZone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Archivo subido -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardFileInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/tvFilesTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_rounded_border"
            android:backgroundTint="#F5F5F5"
            android:padding="16dp"
            android:gravity="center_vertical">

            <!-- Icono del archivo -->
            <LinearLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:gravity="center"
                android:background="@drawable/bg_rounded_border"
                android:backgroundTint="@color/white">
                <ImageView
                    android:id="@+id/ivFileIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/description_image_excel"
                    android:src="@drawable/ic_logo_excel"/>
            </LinearLayout>

            <!-- Información del archivo -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Archivo_ejemplo.xlsx"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="middle" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tvFileSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="92 kB"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginHorizontal="8dp"
                        android:layout_gravity="center_vertical"/>

                    <TextView
                        android:id="@+id/tvValidationTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Validando..."
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Indicador de estado -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:gravity="center">

                <ProgressBar
                    android:id="@+id/progressValidation"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:indeterminate="true"
                    android:visibility="visible" />

                <ImageView
                    android:id="@+id/ivStatusIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/description_image_file_state"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Botón eliminar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemoveFile"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/ic_delete"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/description_image_file_delete" />

        </LinearLayout>

        <!-- Barra de progreso -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:progress="0"
            android:progressTint="@color/progress_bar_color"
            android:visibility="visible" />

    </androidx.cardview.widget.CardView>

    <!-- Botón de acción -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnProcessFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_process_files"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/btn_process_background"
        android:textColor="@android:color/white"
        android:layout_marginTop="16dp"
        android:padding="16dp"
        android:enabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>